generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
}

enum TramoNoches {
  UNA_NOCHE
  DE_DOS_A_SEIS
  SIETE_O_MAS
}

enum Temporada {
  ALTA
  BAJA
}

enum EstadoConsulta {
  PENDIENTE
  RESPONDIDA
}

model Complejo {
  id          String   @id @default(cuid())
  nombre      String
  slogan      String
  descripcion String
  capacidad   Int
  fotos       String[]
  servicios   String[]
  serviciosCompartidos String[]
  politicas   String[]
  precioBase  Decimal  @db.Decimal(10, 2)

  @@map("complejos")
}

model Propiedad {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  capacidad   Int
  promoSemanalAlta  Decimal  @db.Decimal(5, 2) @default(0)
  promoSemanalBaja  Decimal  @db.Decimal(5, 2) @default(0)
  precioNocheAltaUsd Decimal? @db.Decimal(10, 2)
  precioNocheBajaUsd Decimal? @db.Decimal(10, 2)
  precio2a6AltaUsd   Decimal? @db.Decimal(10, 2)
  precio2a6BajaUsd   Decimal? @db.Decimal(10, 2)
  fotos       String[]
  servicios   String[]
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  creadaEn    DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @updatedAt @map("actualizada_en")

  reservas Reserva[]
  resenas  Resena[]

  @@map("propiedades")
}

model Reserva {
  id              String         @id @default(cuid())
  propiedadId     String         @map("propiedad_id")
  huespedNombre   String         @map("huesped_nombre")
  huespedTelefono String         @map("huesped_telefono")
  personas        Int
  fechaIngreso    DateTime       @map("fecha_ingreso") @db.Date
  fechaSalida     DateTime       @map("fecha_salida") @db.Date
  estado          EstadoReserva  @default(PENDIENTE)
  precioTotalEstadia Decimal?     @map("precio_total_estadia") @db.Decimal(10, 2)
  diasEstadia     Int            @map("dias_estadia")
  sena            Decimal?       @db.Decimal(10, 2)
  formaPago       String?        @map("forma_pago")
  totalEstimadoUsd       Decimal?     @map("total_estimado_usd") @db.Decimal(10, 2)
  totalEstimadoArs       Decimal?     @map("total_estimado_ars") @db.Decimal(12, 2)
  precioNocheUsdAplicado Decimal?     @map("precio_noche_usd_aplicado") @db.Decimal(10, 2)
  tipoDolarUsado         String?      @map("tipo_dolar_usado")
  cotizacionUsada        Decimal?     @map("cotizacion_usada") @db.Decimal(12, 2)
  temporadaAplicada      Temporada?   @map("temporada_aplicada")
  tramoAplicado          TramoNoches? @map("tramo_aplicado")
  notas           String?
  creadaEn        DateTime       @default(now()) @map("creada_en")
  actualizadaEn   DateTime       @updatedAt @map("actualizada_en")

  propiedad Propiedad @relation(fields: [propiedadId], references: [id])
  resena    Resena?

  @@map("reservas")
}

model Consulta {
  id       String         @id @default(cuid())
  nombre   String
  email    String?
  mensaje  String
  estado   EstadoConsulta @default(PENDIENTE)
  creadaEn DateTime       @default(now()) @map("creada_en")

  @@map("consultas")
}

model Resena {
  id         String   @id @default(cuid())
  reservaId  String?  @unique @map("reserva_id")
  propiedadId String  @map("propiedad_id")
  perfilId   String?  @map("perfil_id") @db.Uuid
  autor      String
  texto      String
  puntuacion Int
  publicada  Boolean  @default(false)
  creadaEn   DateTime @default(now()) @map("creada_en")

  reserva   Reserva?   @relation(fields: [reservaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  propiedad Propiedad  @relation(fields: [propiedadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  perfil    Perfil?    @relation(fields: [perfilId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([perfilId, propiedadId])
  @@map("resenas")
}

model Imagen {
  id         String   @id @default(cuid())
  url        String
  alt        String
  categoria  String   // "hero", "galeria", "cta", "general"
  orden      Int      @default(0)
  activa     Boolean  @default(true)
  creadaEn   DateTime @default(now()) @map("creada_en")

  @@map("imagenes")
}

enum Rol {
  ADMIN
  HUESPED
}

model Perfil {
  id          String   @id @db.Uuid
  email       String   @unique
  nombre      String?
  apellido    String?
  telefono    String?
  rol         Rol      @default(HUESPED)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  resenas       Resena[]

  @@map("perfiles")
}

model ConfiguracionPrecios {
  id              Int       @id @default(1)
  tipoDolar       String    @default("blue")
  temporadaActiva Temporada @default(ALTA)
  actualizadoEn   DateTime  @updatedAt

  @@map("configuracion_precios")
}

model Cotizacion {
  tipo       String    @id
  compra     Decimal?  @db.Decimal(12, 2)
  venta      Decimal   @db.Decimal(12, 2)
  fechaApi   DateTime?
  obtenidaEn DateTime  @default(now())

  @@map("cotizaciones")
}
