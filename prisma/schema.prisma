generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
}

enum TramoNoches {
  UNA_NOCHE
  DE_DOS_A_SEIS
  SIETE_O_MAS
}

enum EstadoConsulta {
  PENDIENTE
  RESPONDIDA
}

model Complejo {
  id          String   @id @default(cuid())
  nombre      String
  slogan      String
  descripcion String
  capacidad   Int
  fotos       String[]
  servicios   String[]
  serviciosCompartidos String[]
  politicas   String[]
  precioBase  Decimal  @db.Decimal(10, 2)

  @@map("complejos")
}

model Propiedad {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  capacidad   Int
  // Precio "desde $X" para listados. Se calcula dinámicamente como el
  // precioBase mínimo. Se mantiene en la tabla por conveniencia de consulta.
  precioBase  Decimal  @db.Decimal(10, 2)
  promoSemanal Decimal  @db.Decimal(10, 2) @default(0)
  precioNocheAlta  Decimal  @db.Decimal(10, 2) @default(0)
  promoSemanalAlta  Decimal  @db.Decimal(5, 2) @default(0)
  precioNocheBaja  Decimal  @db.Decimal(10, 2) @default(0)
  promoSemanalBaja  Decimal  @db.Decimal(5, 2) @default(0)
  fotos       String[]
  servicios   String[]
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  creadaEn    DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @updatedAt @map("actualizada_en")

  reservas Reserva[]

  @@map("propiedades")
}

model Reserva {
  id              String         @id @default(cuid())
  propiedadId     String         @map("propiedad_id")
  huespedNombre   String         @map("huesped_nombre")
  huespedTelefono String         @map("huesped_telefono")
  personas        Int
  fechaIngreso    DateTime       @map("fecha_ingreso") @db.Date
  fechaSalida     DateTime       @map("fecha_salida") @db.Date
  estado          EstadoReserva  @default(PENDIENTE)
  precioTotalEstadia Decimal?     @map("precio_total_estadia") @db.Decimal(10, 2)
  diasEstadia     Int            @map("dias_estadia")
  sena            Decimal?       @db.Decimal(10, 2)
  formaPago       String?        @map("forma_pago")
  notas           String?
  creadaEn        DateTime       @default(now()) @map("creada_en")
  actualizadaEn   DateTime       @updatedAt @map("actualizada_en")

  propiedad Propiedad @relation(fields: [propiedadId], references: [id])
  resena    Resena?

  @@map("reservas")
}

model Consulta {
  id       String         @id @default(cuid())
  nombre   String
  email    String?
  mensaje  String
  estado   EstadoConsulta @default(PENDIENTE)
  creadaEn DateTime       @default(now()) @map("creada_en")

  @@map("consultas")
}

model Resena {
  id         String   @id @default(cuid())
  reservaId  String   @unique @map("reserva_id")
  autor      String
  texto      String
  puntuacion Int
  publicada  Boolean  @default(false)
  creadaEn   DateTime @default(now()) @map("creada_en")

  reserva Reserva @relation(fields: [reservaId], references: [id])

  @@map("resenas")
}

model Imagen {
  id         String   @id @default(cuid())
  url        String
  alt        String
  categoria  String   // "hero", "galeria", "cta", "general"
  orden      Int      @default(0)
  activa     Boolean  @default(true)
  creadaEn   DateTime @default(now()) @map("creada_en")

  @@map("imagenes")
}
